# Dativo Ingestion Platform - Environment Variables
# 
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then source it:
#   source .env

# ============================================================================
# Core Infrastructure (Required for most jobs)
# ============================================================================

# MinIO / S3 Configuration
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=test-bucket
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# MinIO-specific variables (alternative naming)
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=test-bucket
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Nessie Catalog (Optional - for Iceberg catalog integration)
NESSIE_URI=http://localhost:19120/api/v1

# ============================================================================
# Database Connections (Optional - for database connectors)
# ============================================================================

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=postgres

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=test_db
MYSQL_USER=root
MYSQL_PASSWORD=root

# ============================================================================
# External API Keys (Optional - for SaaS API connectors)
# ============================================================================

# Stripe API Key (for Stripe connector)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_your_stripe_api_key_here

# HubSpot API Key (for HubSpot connector)
# Get from: Settings → Integrations → Private Apps
# Format: pat-na1-xxxxx or pat-eu1-xxxxx
HUBSPOT_API_KEY=pat-na1_your_hubspot_token_here

# Google Application Credentials (for Google Sheets/Drive connectors)
# Path to service account JSON key file
# Download from: Google Cloud Console → IAM & Admin → Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# ============================================================================
# Secret Manager Configuration (Optional)
# ============================================================================

# Secret manager backend (env, filesystem, vault, aws, gcp)
# Defaults to 'env' if not set
# DATIVO_SECRET_MANAGER=env

# Secret manager configuration (JSON string or path to config file)
# DATIVO_SECRET_MANAGER_CONFIG=/path/to/secret-manager-config.yaml

# ============================================================================
# Development / Testing
# ============================================================================

# State directory for incremental sync state
# Defaults to .local/state if not set
# STATE_DIR=.local/state

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
